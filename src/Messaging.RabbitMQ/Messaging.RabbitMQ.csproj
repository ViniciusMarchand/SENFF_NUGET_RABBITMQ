<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SenffTest.Messaging.RabbitMQ</PackageId>
    <Version>1.0.0</Version>
    <Authors>ViniciusMarchand</Authors>
    <Company>ViniciusMarchand</Company>
    <Description>Message library with RabbitMQ.</Description>
    <PackageTags>rabbitmq messaging queue</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Messaging.Abstractions\Messaging.Abstractions.csproj" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
  </ItemGroup>

</Project>
